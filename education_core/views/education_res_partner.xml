<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="education_view_partner_form" model="ir.ui.view">
            <field name="name">res.partner.form</field>
            <field name="model">res.partner</field>
            <field name="priority" eval="1"/>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='internal_notes']" position="before">
                    <page name='education' string="Education">
                        <group name="container_education">
                            <group string="Student" name="student">
                                <field name="is_student"/>
                            </group>
                            <group string="Parent" name="parent">
                                <field name="is_parent"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>


        
        <record id="view_users_inherit" model="ir.ui.view">
            <field name="name">Users view inherit</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='login']" position='after'>
                     <field name="class_id" placeholder="Division" widget="many2many_tags" options='{"no_open": True, "no_create": True}'/>
                     <field name="subject_id" placeholder="Subjects" widget="many2many_tags" options='{"no_open": True, "no_create": True}'/>

                </xpath>
        </field>
    </record>

    </data>
</odoo>