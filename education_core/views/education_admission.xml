<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="view_education_application_tree" model="ir.ui.view">
        <field name="name">education.application.tree</field>
        <field name="model">education.application</field>
        <field name="arch" type="xml">
            <tree string="Student Application">
                <field name="application_no"/>
                <field name="name"/>
                <field name="second_name" required="1"/>
                <field name="middle_name" required="1"/>
                <field name="last_name"/>
                <field name="school_id"/>
                <field name="gender"/>
                <field name="date_of_birth"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="blood_group"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_education_application_form" model="ir.ui.view">
        <field name="name">education.application.form</field>
        <field name="model">education.application</field>
        <field name="arch" type="xml">
            <form string="Student Application">
                 <header>
                    <!-- buttons were there just uncommented them -->
                     <button name="send_to_verify" type="object" class="oe_highlight"
                            string="Send for Verification" 
                            help="Click to send the application for verification purpose"
                            invisible="state != 'draft'"/>
                     <button name="application_verify" type="object" class="oe_highlight"
                            string="Verify Application" 
                            help="Click to verify the application and documents"
                            invisible="state != 'verification'"/>
                     <button name="create_student" string="Create Student"
                                type="object" class="oe_highlight"
                                help="Click to create Student" invisible="state != 'done'"/>
                                <!-- states="approve" -->
                     <button name="%(education_core.application_reject_action)d" string="Reject"
                                type="action"
                                context="{'default_application_id': active_id}"
                                invisible="state != 'approve'"/>
                                <!-- add done button -->
                    <button name="done" string="Done"
                                type="object" class="oe_highlight"
                                invisible="state != 'approve'"/>
                     <field name="state" widget="statusbar" statusbar_visible="draft,verify,approve,done"/>
                 </header>
                 <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="document_view" type="object" icon="fa-list-ol">
                            <field string="Documents" name="document_count" widget="statinfo"/>
                        </button>

                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_left oe_avatar" />
                    <div class="oe_title" style="width:1000px;">
                        <h3>
                            <field name="application_no"/>
                        </h3>
                        <h3>
                            <table>
                                <tr>
                                   
                                    <td style="padding-right:10px;width:100px;"><field name="name" placeholder="First Name" required="1" /></td>
                                    <td style="padding-right:10px;width:100px;"><field name="second_name" placeholder="Second Name" required="1"/></td>
                                    <td style="padding-right:10px;width:100px;"><field name="middle_name" placeholder="Middle Name" required="1"/></td>
                                    <td style="padding-right:10px;width:100px;"><field name="last_name" placeholder="Last Name" required="1" /></td>
                                </tr>
                            </table>
                        </h3>
                    </div>
                    <separator/>

                    <separator string="Personal Details"/>
                    <group>
                        <group>
                            <field name="date_of_birth" readonly= "state == 'done'" />
                  
                           <field name="parent_ids" readonly= "state == 'done'" required="1"/>
                           <field name="guardian_relationship" />
                            <!-- <field name="have_sibling"/> -->
                            <!-- <field name="percentage" /> -->
                            <field name="sib_percentage" invisible="student_sibling_ids == []"/>
                        </group>
                        <group>
                            <field name="gender" widget="radio"
                                options="{'horizontal': true}" readonly= "state == 'done'" required="1"/>
                            <field name="previous_mark"/>

                            <field name="nationality" readonly= "state == 'done'" invisible="1"/>
                            <field name="religion_id" readonly= "state == 'done'" invisible="1"/>
                            <field name="mother_name" readonly= "state == 'done'"/>
                             <field name="student_sibling_ids" widget="many2many_tags" />
                        </group>
                    </group>
                    <!-- <separator/> -->
                    <group string="Admission Details">
                        <group>
                            <field name="academic_year_id" required="1" readonly= "state == 'done'" options="{'no_create':1,'no_open': True}"/>
                            
                            <field name="school_id" widget="selection" help="School of Student" required="1" readonly= "state == 'done'"/>
                            <field name="admission_class" required="1" options="{'no_create':1,'no_open': True}" readonly= "state == 'done'"/>
                            <field name="class_id" options="{'no_create':1,'no_open': True}"   domain="[('class_id', '=', admission_class)]"/>
                      </group>
                        <group>
                            <field name="admission_date" readonly="1"/>
                            <field name="prev_school" readonly= "state == 'done'"/>
                            
                        </group>
                    </group>
                    


                    <group>
                        <separator string="Contact Address"/>
                        <group>
                            <div>
                                <!-- <field name="home_no" required="0" placeholder="Home No" class="o_address_street" attrs="{'readonly': [('state', '=', 'done')]}"/> -->
                                <!-- <field name="block" placeholder="Block" class="o_address_street" attrs="{'readonly': [('state', '=', 'done')]}"/> -->
                                <field name="zone_id" placeholder="Area" required="1" class="o_address_city" readonly= "state == 'done'"/>
                 
                            </div>
                        </group>
                      <!-- <field name="is_same_address" attrs="{'readonly': [('state', '=', 'done')]}"/> -->
                        <div name="permanent_address" invisible="1">
                            <separator string="Permanent Address"/>
                            <group>
                                <div class="o_address_format">
                                    <field name="per_street" placeholder="Street..." class="o_address_street"/>
                                    <field name="per_street2" placeholder="Street 2..." class="o_address_street"/>
                                    <field name="per_city" placeholder="City" class="o_address_city"/>
                                    <field name="per_state_id" class="o_address_state" placeholder="State" options='{"no_open": True}'/>
                                    <field name="per_zip" placeholder="ZIP" class="o_address_zip"/>
                                    <field name="per_country_id" placeholder="Country" class="o_address_country" options='{"no_open": True, "no_create": True}'/>
                                </div>
                            </group>
                        </div>
                    </group>
                    <separator string="Contact Details"/>
                    <group name="contact_info">
             
                        <group>
                            <field name="phone" required="1" readonly= "state == 'done'"/>
                            <field name="mobile"  readonly= "state == 'done'"/>
                        </group>
                    </group>
                    <group string="Reject Reason" invisible= "reject_reason == False" >
                        <group>
                            <field name="reject_reason" invisible= "reject_reason == False"/>
                        </group>
                    </group>
                     <group name="amenity_info" string="">
                         </group>
                     <separator string="Notes"/>
                     <field name="description"/>
                 </sheet>

                 <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                 </div>

            </form>
        </field>
    </record>

    <record id="view_education_application_graph" model="ir.ui.view">
        <field name="name">education.application.graph</field>
        <field name="model">education.application</field>
        <field name="arch" type="xml">
            <graph string="Application">
                <field name="admission_class"/>
                <field name="academic_year_id"/>
            </graph>
        </field>
    </record>

    <record id="view_education_application_pivot" model="ir.ui.view">
        <field name="name">education.application.pivot</field>
        <field name="model">education.application</field>
        <field name="arch" type="xml">
            <pivot string="Application">
                <field name="admission_class" type="row"/>
                <field name="admission_date" interval="month" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="application_search" model="ir.ui.view">
        <field name="name">Student Application</field>
        <field name="model">education.application</field>
        <field name="arch" type="xml">
            <search string="Search Application">
                <field name="name"/>
                <field name="second_name"/>
                <field name="middle_name"/>
                <field name="last_name"/>
                <field name="admission_class"/>
              <field name="gender"/>
                <field name="religion_id"/>
                <field name="caste_id"/>
                <field name="mother_tongue"/>
                <filter string="New Application" name="new_application" domain="[('state','!=','done')]"/>
                <filter string="Draft" name="draft_filter" domain="[('state','=','draft')]"/>
                <filter string="Done" name="active" domain="[('state','=','done')]"/>
                <filter string="Rejected" name="rejected" domain="[('state','=','reject')]"/>
                <group expand='0' string='Group by...'>
                    <filter string='Admission To' icon="fa-user" name="admission_class" domain="[]" context="{'group_by' : 'admission_class'}"/>
                    <filter string='Academic Year' icon="fa-user" name="academic_year_id" domain="[]" context="{'group_by' : 'academic_year_id'}"/>
                    <filter string='Gender' icon="fa-genderless" name="gender" domain="[]" context="{'group_by' : 'gender'}"/>
        <filter string='Religion' icon="fa-pencil-square-o" name="religion_id" domain="[]" context="{'group_by' : 'religion_id'}"/>
                    <filter string='Caste' icon="fa-pencil-square-o" name="caste_id" domain="[]" context="{'group_by' : 'caste_id'}"/>
                    <filter string='Mother Tongue' icon="fa fa-language" name="mother_tongue" domain="[]" context="{'group_by' : 'mother_tongue'}"/>
               </group>
           </search>
        </field>
    </record>


    <record id="action_student_application" model="ir.actions.act_window">
        <field name="name">Student Application</field>
        <field name="res_model">education.application</field>
        <field name="type">ir.actions.act_window</field>
        <!-- <field name="view_type">form</field> -->
        <field name="view_mode">tree,form,graph,pivot</field>
        <field name="search_view_id" ref="application_search"/>
        <field name="domain">[('academic_year_id.current_year', '=', True)]</field>
        <field name="context">{'search_default_new_application': 1}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Create the your first student application here.
            </p>
        </field>
    </record>


    <menuitem id="menu_education_admission" name="Admission" parent="menu_education_root" sequence="5"/>
    <menuitem id="menu_education_application" name="Application"
              parent="menu_education_admission" action="action_student_application"/>
</odoo>
