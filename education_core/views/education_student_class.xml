<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_education_student_class_tree" model="ir.ui.view">
        <field name="name">education.student.class.tree</field>
        <field name="model">education.student.class</field>
        <field name="arch" type="xml">
            <tree string="Assign Class">
                <field name="class_id"/>
            </tree>
        </field>
    </record>

    <record id="view_education_student_class_form" model="ir.ui.view">
        <field name="name">education.student.class.form</field>
        <field name="model">education.student.class</field>
        <field name="arch" type="xml">
            <form string="Assign Class">
                <header>
                    <button name="get_student_list" type="object"
                            string="Get Students" 
                            help="Click to get student list" invisible="state != 'draft'"/>
                            <!--  <button name="get_student_list" type="object"
                            string="Get Students" 
                            help="Click to get student list" states="draft"/> -->
                    <button name="%(education_core.application_create_student)d" string="Assign Class"
                                type="action" class="oe_highlight"
                                context="{'default_id': active_id, 'default_student_class': class_id,
                                'default_assigned_by': assigned_by}"
                                help="Click to assign class for selected students"
                                invisible="state != 'draft'"/>
                                <!-- <button name="%(education_core.application_create_student)d" string="Assign Class"
                                type="action" class="oe_highlight"
                                context="{'default_id': active_id, 'default_student_class': class_id,
                                'default_assigned_by': assigned_by}"
                                help="Click to assign class for selected students"
                                states="draft"/> -->
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet string="Assign Students">
                    <group>
                        <group>
                            <field name="class_id" readonly="state == 'done'" options="{'no_create':1,'no_open': True}"/>
                            <field name="assigned_by" invisible="state != 'done'" options="{'no_create':1,'no_open': True}"/>
                             <field name="checkAll" invisible="student_list == []"/>
                        </group>
                        <group>
                             <field name="admitted_class" invisible="admitted_class == False" options="{'no_create':1,'no_open': True}"/>
                             <field name="school_id" options="{'no_create':1,'no_open': True}"/> 
                        </group>
                    </group>
                    <notebook>
                        <page string="Student List">
                            <!-- <group> -->
                            <field name="student_list" nolabel="1">
                                <tree create="0" delete="0" editable="bottom">
                                    <field name="check_student"/>
                                    <field name="student_id" readonly="1"/>
                                    <field name="status" readonly="1"/>
                                    <field name="class_id" readonly="1"/>
                                    <field name="class_room" readonly="1"/>
                                    <field name="previous_mark" readonly="1"/>
                                    <field name="prev_school" readonly="1"/>

                                </tree>
                            </field>
                          <!-- </group> -->
                       
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_student_class" model="ir.actions.act_window">
        <field name="name">Assign Class</field>
        <field name="res_model">education.student.class</field>
        <field name="type">ir.actions.act_window</field>
        <!-- <field name="view_type">form</field> -->
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Assign students to class from here.
            </p>
        </field>
    </record>

    <menuitem id="menu_education_student_class" name="Assign Class" sequence="25"
              parent="menu_education_admission" groups="education_core.group_education_hod" action="action_student_class"/>

</odoo>
