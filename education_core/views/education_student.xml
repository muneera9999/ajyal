        <field name="name">Alumni Students</field>
        <field name="res_model">education.student</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="student_search"/>
        <field name="domain">[('state', '=', 'alumni')]</field>

        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Create the your first student here.
            </p>
        </field>
    </record> -->

    <!-- students menue -->

    <menuitem id="menu_education_student" name="Students" sequence="1"
              parent="menu_education_admission" action="action_student"/>
              <!-- alumnies menue -->
              <!-- <menuitem id="menu_alumni_education_student" name="Alumni Students" 
              parent="menu_education_admission" action="action_alumni_student"/> -->
</odoo>




