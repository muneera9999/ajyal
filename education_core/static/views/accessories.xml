<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<record id="accessories_form_view" model="ir.ui.view">
		<field name="name">student.accessories.form</field>
        <field name="model">student.accessories</field>
        <field name="arch" type="xml">
		<form string="Accessories">
			<sheet>
                           
                            <group>
                            	<group><field name="name" placeholder="Accessory Name"/></group>
                                <group><field name="studentClass"/></group>
                            </group>
                        
                            <newline />
                            <field name="accessoryLine_ids" nolabel="1" colspan="3">
                                <tree>
                                	<field name="accessoryType"/>
                                    <field name="quantity" />
                                 </tree>
                                 <form>
                                     <group>
                                     	<group >
                                        <field name="accessoryType"/>
                                         </group>
                                        <group >
                                        	<field name="quantity" placeholder="10"/>
                                        </group>
                                     </group>
                                 </form>
                             </field>
			</sheet>
		</form>
	</field>
	</record>
	<record id="accessories_tree_view" model="ir.ui.view">
		<field name="name">student.accessories.tree</field>
        <field name="model">student.accessories</field>
        <field name="arch" type="xml">
		<tree string="Accessories">
			<field name="name"/>
			<field name="studentClass"/>
		</tree>
	</field>
	</record>
	<record id="action_accessories" model="ir.actions.act_window">
		  <field name="name">Accessories</field>
            <field name="res_model">student.accessories</field>
            <field name="view_mode">tree,form</field>
	</record>
	<menuitem id="accessories_main_menu" name="Accessories Settings"
		     parent="education_core.menu_education_main_menu"/>
    <menuitem id="accessories_menu" name="Accessories"
     parent="accessories_main_menu" action="action_accessories"/>
     <menuitem id="accessories_types_menu" name="Accessories Types"
     parent="accessories_main_menu"/>
</odoo>