<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view" id="view_education_student_kanban">
        <field name="name">education.student.kanban</field>
        <field name="model">education.student</field>
        <field name="arch" type="xml">
            <kanban class="education_student_kanban">
                <field name="id"/>
                <field name="name"/>
                <field name="parent_ids"/>
                <field name="class_id"/>
                <field name="city"/>
                <field name="mobile"/>
                <field name="state"/>
                <field name="image"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_res_partner_kanban">
                            <div class="o_kanban_image">
                                <t t-if="record.image.raw_value">
                                    <img t-att-src="kanban_image('education.student', 'image', record.id.raw_value)"/>
                                </t>
                                <t t-if="!record.image.raw_value">
                                    <img t-att-src='_s + "/base/static/src/img/avatar.png"'/>
                                </t>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title oe_partner_heading"><field name="name"/></strong>
                                <div class="o_kanban_tags_section oe_kanban_partner_categories"/>
                                <ul>
                                    <li t-if="record.class_id.raw_value">
                                        Class : <field name="class_id"/>
                                    </li>
                                    <li t-if="record.parent_ids.raw_value">
                                        Parent : <field name="parent_ids"/>
                                    </li>
                                    <li t-if="record.mobile.raw_value">
                                        <i class="fa fa-phone"/>
                                        <field name="mobile"/>
                                    </li>
                                    <li t-if="record.email.raw_value">
                                        <i class="fa fa-envelope"/>
                                        <a t-attf-href="mailto:#{record.email.value}">
                                            <field name="email"/>
                                        </a>
                                    </li>
                                     <li t-if="record.state.raw_value">
                                        status : <field name="state"/>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_education_student_tree" model="ir.ui.view">
        <field name="name">education.student.tree</field>
        <field name="model">education.student</field>
        <field name="arch" type="xml">
            <tree string="Student" colors="red:state=='not_registered';green:state=='registered';yellow:state=='pendent';grey:state=='alumni';purple:state=='transfer';">
                <field name="ad_no"/>
                <field name="name"/>
               <field name="gender"/>
                <field name="date_of_birth"/>
                <field name="email"/>
                <field name="mobile"/>
                <field name="state"/>

            </tree>
        </field>
    </record>

    <record id="view_education_student_form" model="ir.ui.view">
        <field name="name">education.student.form</field>
        <field name="model">education.student</field>
        <field name="arch" type="xml">
            <form string="Student">
                 <header>
                        <button name="action_rigster" string="Rigster" states="not_registered,pendent" type="object" 
                                class="oe_highlight" />
                        <button name="action_alumni" string="Alumni" states="registered" type="object" 
                                class="oe_highlight" />
                        <button name="action_pendent" string="Pendent" states="registered,not_registered" type="object" 
                                class="oe_highlight" />
                        <button name="action_leave" string="Leave" states="registered,not_registered,transfered,pendent,alumni" type="object" 
                                class="oe_highlight" />
                        <field name="state" widget="statusbar" statusbar_visible="not_registered,registered,pendent,transfer,leave,alumni"/>
                        <button name="Update_student" string="update"  type="object" 
                                class="oe_highlight" />
                    </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="student_documents" type="object" widget="statinfo"
                                class="oe_stat_button" icon="fa-shoping-car" string="Documents">
                        </button>

                         <button name="stock_deivery_order" type="object" widget="statinfo"
                                class="oe_stat_button" icon="fa-shoping-card">
                            <field string="accessories" name="accessories_count" widget="statinfo"/>

                        </button>
                    </div>
                   
                    
                    <div class="oe_title">
                        <field name="image" widget="image" class="oe_left oe_avatar" />
                        <h3>
                            <field name="ad_no" attrs="{'invisible': [('ad_no', '=',False)]}"/>
                        </h3>

                        <h1>
                            <label for="name" class="oe_edit_only"/>
                            <field name="name" placeholder="Student's Name" required="1"/>
                        </h1>
                    </div>
                 
                    <notebook>
                        <page string="Student Details">
                            <separator string="Basic Details"/>
                             <group>
                                <group>
                                    
                                    <field name="admission_class"/>
                                    <field name="class_id"/>
                                </group>
                                <group>
                                    <field name="school_id"/>
                                </group>
                            </group>
                            <separator string="Student Info"/>
                            <group>
                                <group>
                               <field name="mother_name"/>
                                    <field name="parent_ids"/>
                                    <field name="nationality"/>
                                </group>
                                <group>
                                    <field name="gender"/>
                                    <field name="date_of_birth"/>
                                    <field name="religion_id"/>
                                    <field name="mother_tongue"/>
                                    
                                </group>
                            </group>
                             <group name="amenity_info">
                             </group>
                        </page>
                        <page string="Contact Details">
                            <group>
                                <group>
                                    <field name="email"/>
                                </group>
                                <group>
                                    <field name="phone"/>
                                    <field name="mobile" required="0"/>
                                </group>
                            </group>
                            <group>
                                <separator string="Address"/>
                                <div name="temp_address">
                                    <group>
                                        <div class="o_address_format">
                                            <field name="street" placeholder="Street..." class="o_address_street"/>
                                            <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                            <field name="city" placeholder="City" class="o_address_city"/>
                                            <field name="state_id" class="o_address_state" placeholder="State" options='{"no_open": True}'/>
                                            <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                            <field name="country_id" placeholder="Country" class="o_address_country" options='{"no_open": True, "no_create": True}'/>
                                        </div>
                                    </group>
                                </div>
                                <field name="is_same_address" invisible="1"/>
                                <div name="permanent_address" attrs="{'invisible': [('is_same_address','=', True)]}">
                                    <separator string="Permanent Address"/>
                                    <group>
                                        <div class="o_address_format">
                                            <field name="per_street" placeholder="Street..." class="o_address_street"/>
                                            <field name="per_street2" placeholder="Street 2..." class="o_address_street"/>
                                            <field name="per_city" placeholder="City" class="o_address_city"/>
                                            <field name="per_state_id" class="o_address_state" placeholder="State" options='{"no_open": True}'/>
                                            <field name="per_zip" placeholder="ZIP" class="o_address_zip"/>
                                            <field name="per_country_id" placeholder="Country" class="o_address_country" options='{"no_open": True, "no_create": True}'/>
                                        </div>
                                    </group>
                                </div>
                            </group>
                        </page>
                         <page string="Emergency Calls">
                            
                            <field name="emergency_calls">
                            <tree>
                                <field name="name"/>
                                <field name="phone"/>
<!--                                 <field name="relationship"/>
 -->                            </tree>
                        </field>
                       </page>
                        <page string="Class History">
                            <field name="class_history_ids">
                                <tree editable="bottom">
                                    <field name="academic_year_id" required="1"/>
                                    <field name="class_id" required="1"/>
                                </tree>
                            </field>
                        </page>
                             <page string="Medical">
                                <group>
                                    <group string="Doctor Information">
                                        <field name="designation" placeholder="Doctor Designation" />
                                        <field name="doctor_phone" placeholder="Doctor's Contact No" />
                                    </group>
                                    <group string="Physical Information">
                                        <field name="blood_group" placeholder="e.g.B+,Ab+" />
                                        <field name="height" placeholder="Height"/>
                                        <field name="weight"  placeholder="Weight"/>
                                    </group>
                                </group>
                                <separator string="Does the applicant have any Disabilities?" colspan="4" />
                                <group col="6" colspan="4">
                                    <field name="eye" />
                                    <field name="ear" />
                                    <field name="nose_throat" />
                                    <field name="respiratory" />
                                    <field name="cardiovascular" />
                                    <field name="neurological" />
                                    <field name="muskoskeletal" />
                                    <field name="dermatological" />
                                    <field name="blood_pressure" />
                                </group>
                                <separator string="Notes" colspan="4" />
                                <group col="6" colspan="4">
                                    <field name="comment" placeholder="Notes About Medical.." nolabel="1" />
                                </group>
                            </page>
                    </notebook>

                </sheet>

            </form>
        </field>
    </record>

    <record id="student_search" model="ir.ui.view">
        <field name="name">Students</field>
        <field name="model">education.student</field>
        <field name="arch" type="xml">
            <search string="Search Students">
                <field name="name"/>
                <field name="class_id"/>
                <field name="admission_class"/>
                <field name="gender"/>
                <field name="religion_id"/>
                <field name="mother_tongue"/>
                <field name="parent_ids"/>
                <field name="state"/>
                <field name="ad_no"/>
                <group expand='0' string='Group by...'>
                    <filter string='Class' icon="fa-user" domain="[]" context="{'group_by' : 'admission_class'}"/>
                    <filter string='Class Room' icon="fa-user" domain="[]" context="{'group_by' : 'class_id'}"/>
                    <filter string='Gender' icon="fa-genderless" domain="[]" context="{'group_by' : 'gender'}"/>
        <filter string='Religion' icon="fa-pencil-square-o" domain="[]" context="{'group_by' : 'religion_id'}"/>
                    <filter string='Mother Tongue' icon="fa fa-language" domain="[]" context="{'group_by' : 'mother_tongue'}"/>
                    <filter string='Guardian' icon="fa-user" domain="[]" context="{'group_by' : 'parent_ids'}"/>
                    <filter string='status'  domain="[]" context="{'group_by' : 'state'}"/>
               </group>
           </search>
        </field>
    </record>

    <record id="action_student" model="ir.actions.act_window">
        <field name="name">Student</field>
        <field name="res_model">education.student</field>
        <field name="type">ir.actions.act_window</field>
        <!-- <field name="view_type">form</field> -->
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="student_search"/>
        <field name="context">{'create': True}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Create the your first student here.
            </p>
        </field>
    </record>

    <menuitem id="menu_education_student" name="Student" sequence="10"
              parent="menu_education_admission" action="action_student"/>
</odoo>
