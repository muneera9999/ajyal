<?xml version="1.0"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="transfer_wizard_form">
            <field name="name">Transfer Wizard form</field>
            <field name="model">student.transfer</field>
            <field name="arch" type="xml">
                <form string="Student Transfer" version="7.0">
                    <sheet>
                               <script>
            $(document).ready(function(){
                $('.modal-dialog').css({'width': '600', 'height': '450px'});
                $('.modal-content').css({'height': '450px'});
                $('.modal-body').css({'height': '450px'});
                $('.o_group').css({'width':'450'});
            });
        </script>
                    <label for="target_move"/>
                    <field name="target_move" widget="radio"/>
                <group >
                 <field name="school_id" invisible= "target_move != 'school'"/>
                  <field name="class_id"  widget="selection" invisible="target_move != 'class'" />
                <field name="academic_year" options="{'no_create': True}" widget="selection" invisible="1"/> 
                <field name="division_id" options="{'no_create': True}" widget="selection" invisible="target_move not in ['division','class']"/>
        </group>
          
                    </sheet>
                    <footer>
                        <span groups="base.group_user">
                            <button name="action_transfer" type="object"
                            string="Transfer" class="oe_highlight" />
                            <button string="Cancel" special="cancel" />
                        </span>
                    </footer>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_student_transfer">
            <field name="name">Transfer Wizard</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">student.transfer</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>
        <!-- <record model="ir.actions.act_window.view" id="act_exam_result_wizard_view_form">
            <field name="act_window_id" ref="act_exam_result_wizard_view" />
            <field name="sequence" eval="20" />
            <field name="view_mode">form</field>
            <field name="view_id" ref="exam_result_wizard_form" />
        </record> -->
  

    </data>
</odoo>
